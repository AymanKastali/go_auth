# Stage 1 — Build
FROM golang:1.25-bookworm AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY ./cmd ./cmd
COPY ./internal ./internal
ARG VERSION=dev
RUN go build -ldflags="-s -w -X main.version=${VERSION}" -o /main ./cmd/auth/main.go

# Stage 2 — Runtime
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /
COPY --from=builder /main /main
EXPOSE 8080
ENTRYPOINT ["/main"]