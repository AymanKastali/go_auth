@startuml DomainServices
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

title Domain Services — Interfaces, Implementations & Dependency Wiring

package "Domain Services" {

    interface IRegistrationService {
        + RegisterNewMember(ctx, id, email, pwd, now) : (*User, error)
        + RegisterNewSuperAdmin(ctx, id, email, pwd, now) : (*User, error)
    }

    class registrationService <<Domain Service>> {
        - userRepo : IUserRepository
        - roleProvider : IRegistrationRoleProvider
        - registerPolicy : IRegisterPolicy
        - activationPolicy : IActivationPolicy
        __
        + {static} NewRegistrationService(userRepo, roleProvider, registerPolicy, activationPolicy) : *registrationService
        + RegisterNewMember(ctx, id, email, pwd, now) : (*User, error)
        + RegisterNewSuperAdmin(ctx, id, email, pwd, now) : (*User, error)
    }

    interface IAuthenticationService {
        + AuthenticateAndEstablishSession(ctx, user, rawPassword, identity, now) : (RawToken, *Session, error)
        + RefreshSession(ctx, rawToken, fp, now) : (*User, *Session, error)
    }

    class authenticationService <<Domain Service>> {
        - userRepo : IUserRepository
        - sessionRepo : ISessionRepository
        - tokenSvc : ITokenService
        - idGen : IIDGenerator
        - sessionPolicy : ISessionPolicy
        - passwordMgr : IPasswordManager
        __
        + {static} NewAuthenticationService(userRepo, sessionRepo, tokenSvc, idGen, sessionPolicy, passwordMgr) : IAuthenticationService
        + AuthenticateAndEstablishSession(ctx, user, rawPassword, identity, now) : (RawToken, *Session, error)
        + RefreshSession(ctx, rawToken, fp, now) : (*User, *Session, error)
    }

    interface IAccessManager {
        + GrantImmediateAccess(ctx, user, sid, now) : (AccessToken, Timepoint, error)
        + VerifyAccess(ctx, token, now) : (*User, SessionID, error)
    }

    class accessManager <<Domain Service>> {
        - userRepo : IUserRepository
        - sessionRepo : ISessionRepository
        - roleRepo : IRoleRepository
        - accessSvc : IAccessService
        - accessPolicy : IAccessPolicy
        __
        + {static} NewAccessManager(userRepo, sessionRepo, roleRepo, accessSvc, accessPolicy) : IAccessManager
        + GrantImmediateAccess(ctx, user, sid, now) : (AccessToken, Timepoint, error)
        + VerifyAccess(ctx, token, now) : (*User, SessionID, error)
    }

    interface IUserAccountManager {
        + InitiatePasswordReset(user, now) : (RawToken, *RecoveryToken, error)
        + ChangePassword(user, oldPass, newPass, now) : error
        + ResetPasswordByToken(user, recovery, newPassword, now) : error
        + InitiateActivation(user, now) : (RawToken, *ActivationToken, error)
        + ConfirmActivation(user, activation, now) : error
    }

    class userAccountManager <<Domain Service>> {
        - tokenSvc : ITokenService
        - passwordMgr : IPasswordManager
        - idGen : IIDGenerator
        - recoveryPolicy : IRecoveryPolicy
        - activationPolicy : IActivationPolicy
        __
        + {static} NewUserAccountManager(tokenSvc, passwordMgr, idGen, recoveryPolicy, activationPolicy) : IUserAccountManager
        + InitiatePasswordReset(user, now) : (RawToken, *RecoveryToken, error)
        + ChangePassword(user, oldPass, newPass, now) : error
        + ResetPasswordByToken(user, recovery, newPassword, now) : error
        + InitiateActivation(user, now) : (RawToken, *ActivationToken, error)
        + ConfirmActivation(user, activation, now) : error
    }

    interface IPasswordManager {
        + ValidateAndHashNewPassword(raw RawPassword) : (HashedPassword, error)
        + Compare(raw RawPassword, hashed HashedPassword) : bool
    }

    class passwordManager <<Domain Service>> {
        - svc : IPasswordService
        - policy : IPasswordPolicy
        __
        + {static} NewPasswordManager(svc, policy) : *passwordManager
        + ValidateAndHashNewPassword(raw RawPassword) : (HashedPassword, error)
        + Compare(raw RawPassword, hashed HashedPassword) : bool
    }

    IRegistrationService <|.. registrationService
    IAuthenticationService <|.. authenticationService
    IAccessManager <|.. accessManager
    IUserAccountManager <|.. userAccountManager
    IPasswordManager <|.. passwordManager
}

package "Ports" <<Cloud>> {
    interface IUserRepository <<port>>
    interface ISessionRepository <<port>>
    interface IRoleRepository <<port>>
    interface ITokenService <<port>>
    interface IIDGenerator <<port>>
    interface IAccessService <<port>>
    interface IPasswordService <<port>>
    interface IRegistrationRoleProvider <<port>>
}

package "Policies" <<Cloud>> {
    interface IRegisterPolicy <<policy>>
    interface ISessionPolicy <<policy>>
    interface IAccessPolicy <<policy>>
    interface IRecoveryPolicy <<policy>>
    interface IActivationPolicy <<policy>>
    interface IPasswordPolicy <<policy>>
}

registrationService --> IUserRepository
registrationService --> IRegistrationRoleProvider
registrationService --> IRegisterPolicy
registrationService --> IActivationPolicy

authenticationService --> IUserRepository
authenticationService --> ISessionRepository
authenticationService --> ITokenService
authenticationService --> IIDGenerator
authenticationService --> ISessionPolicy
authenticationService --> IPasswordManager

accessManager --> IUserRepository
accessManager --> ISessionRepository
accessManager --> IRoleRepository
accessManager --> IAccessService
accessManager --> IAccessPolicy

userAccountManager --> ITokenService
userAccountManager --> IPasswordManager
userAccountManager --> IIDGenerator
userAccountManager --> IRecoveryPolicy
userAccountManager --> IActivationPolicy

passwordManager --> IPasswordService
passwordManager --> IPasswordPolicy

@enduml
