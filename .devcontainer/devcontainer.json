{
    "name": "GoAuth",
    "dockerComposeFile": "docker-compose.dev.yml",
    "service": "web",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "cweijan.vscode-postgresql-client2",
                "mhutchie.git-graph",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "postCreateCommand": "bash scripts/install-hooks.sh",
    "shutdownAction": "none"
}
