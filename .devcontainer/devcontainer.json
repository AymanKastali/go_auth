{
    "name": "GoAuth",
    "dockerComposeFile": [
        "../docker-compose.yml",
        "../docker-compose.override.yml"
    ],
    "service": "web",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "cweijan.vscode-postgresql-client2",
                "mhutchie.git-graph",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    },
    "shutdownAction": "none"
}