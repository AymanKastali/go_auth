        __
        + {static} NewUserLoginFailed(userID, email, attemptNumber, now) : UserLoginFailed
        + EventName() : string
        + OccurredAt() : time.Time
        + AggregateID() : string
        + Email() : string
        + AttemptNumber() : int
    }

    class UserAccountLocked <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        - lockedUntil : time.Time
        __
        + {static} NewUserAccountLocked(userID, lockedUntil, now) : UserAccountLocked
        + EventName() : string
        + OccurredAt() : time.Time
        + AggregateID() : string
        + LockedUntil() : time.Time
    }

    class UserDeleted <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        __
        + {static} NewUserDeleted(userID, now) : UserDeleted
        + EventName() : string
        + OccurredAt() : time.Time
        + AggregateID() : string
    }

    DomainEvent <|.. UserRegistered
    DomainEvent <|.. UserActivated
    DomainEvent <|.. UserDeactivated
    DomainEvent <|.. RoleAssigned
    DomainEvent <|.. RoleRevokedFromUser
    DomainEvent <|.. EmailUpdated
    DomainEvent <|.. PasswordChanged
    DomainEvent <|.. UserLoginFailed
    DomainEvent <|.. UserAccountLocked
    DomainEvent <|.. UserDeleted
}

