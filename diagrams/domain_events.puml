@startuml DomainEvents
!theme plain
skinparam classAttributeIconSize 0

title Domain Events

package "Event Infrastructure" {

    interface DomainEvent {
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
    }

    class EventRecorder <<Mixin>> {
        - events : []DomainEvent
        + RecordEvent(event DomainEvent)
        + CollectEvents() : []DomainEvent
    }

    EventRecorder o-- "0..*" DomainEvent : collects
}

package "User Events" {

    class UserRegistered <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        - email : string
        __
        + {static} NewUserRegistered(userID, email, now) : UserRegistered
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
        + Email() : string
    }

    class UserActivated <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        __
        + {static} NewUserActivated(userID, now) : UserActivated
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
    }

    class UserDeactivated <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        __
        + {static} NewUserDeactivated(userID, now) : UserDeactivated
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
    }

    class RoleAssigned <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        - roleName : string
        __
        + {static} NewRoleAssigned(userID, role, now) : RoleAssigned
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
        + RoleName() : string
    }

    class RoleRevokedFromUser <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        - roleName : string
        __
        + {static} NewRoleRevokedFromUser(userID, role, now) : RoleRevokedFromUser
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
        + RoleName() : string
    }

    class EmailUpdated <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        - oldEmail : string
        - newEmail : string
        __
        + {static} NewEmailUpdated(userID, oldEmail, newEmail, now) : EmailUpdated
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
        + OldEmail() : string
        + NewEmail() : string
    }

    class PasswordChanged <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        __
        + {static} NewPasswordChanged(userID, now) : PasswordChanged
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
    }

    class UserDeleted <<Domain Event>> {
        - occurredAt : Timepoint
        - aggregateID : string
        __
        + {static} NewUserDeleted(userID, now) : UserDeleted
        + EventName() : string
        + OccurredAt() : Timepoint
        + AggregateID() : string
    }

    DomainEvent <|.. UserRegistered
    DomainEvent <|.. UserActivated
    DomainEvent <|.. UserDeactivated
    DomainEvent <|.. RoleAssigned
    DomainEvent <|.. RoleRevokedFromUser
    DomainEvent <|.. EmailUpdated
    DomainEvent <|.. PasswordChanged
    DomainEvent <|.. UserDeleted
}

