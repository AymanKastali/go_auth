@startuml Aggregates
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho

title Domain Aggregates

package "User Aggregate" <<Rectangle>> {

    class User <<Aggregate Root>> {
        - id : UserID
        - email : Email
        - passwordHash : HashedPassword
        - isActive : bool
        - roles : []RoleName
        - isDeleted : bool
        - registeredAt : Timepoint
        __constructors__
        + {static} NewUser(userID, email, passwordHash, registeredAt) : (*User, error)
        + {static} ReconstituteUser(id, email, passwordHash, isActive, roles, isDeleted, registeredAt) : *User
        __getters__
        + ID() : UserID
        + Email() : Email
        + HashedPassword() : HashedPassword
        + Roles() : []RoleName
        + IsDeleted() : bool
        + IsActive() : bool
        + RegisteredAt() : Timepoint
        + RoleNames() : []string
        __business methods__
        + Activate(now Timepoint) : error
        + Deactivate(now Timepoint) : error
        + AssignRole(role RoleName, now Timepoint) : error
        + RemoveRole(role RoleName, now Timepoint) : error
        + MarkDeleted(now Timepoint) : error
        + UpdateEmail(newEmail Email, now Timepoint) : error
        + UpdatePassword(newHash HashedPassword, now Timepoint) : error
    }

    class EventRecorder <<Mixin>> {
        - events : []DomainEvent
        + RecordEvent(event DomainEvent)
        + CollectEvents() : []DomainEvent
    }

    User *-- "0..*" RoleName : has
    User o-- EventRecorder : embeds
}

package "Session Aggregate" <<Rectangle>> {

    class Session <<Aggregate Root>> {
        - id : SessionID
        - userID : UserID
        - hashedToken : HashedToken
        - identity : DeviceIdentity
        - expiresAt : Timepoint
        - lastActiveAt : Timepoint
        - isRevoked : bool
        __constructors__
        + {static} NewSession(id, userID, hashedToken, identity, expiresAt, now) : (*Session, error)
        + {static} ReconstituteSession(id, userID, hashedToken, identity, expiresAt, lastActiveAt, isRevoked) : *Session
        __getters__
        + ID() : SessionID
        + UserID() : UserID
        + HashedToken() : HashedToken
        + ExpiresAt() : Timepoint
        + LastActiveAt() : Timepoint
        + IsRevoked() : bool
        + Identity() : DeviceIdentity
        + DisplayName() : string
        __business methods__
        + IsValid(now Timepoint) : bool
        + ValidateFingerprint(fp DeviceFingerprint) : bool
        + UpdateLogin(newToken HashedToken, newExpiry Timepoint, now Timepoint)
        + Revoke(now Timepoint) : error
        + Refresh(currentFP DeviceFingerprint, now Timepoint) : error
        + UpdateActivity(now Timepoint)
    }

    Session o-- EventRecorder : embeds
    Session --> UserID : references
}

package "Role Aggregate" <<Rectangle>> {

    class Role <<Aggregate Root>> {
        - id : RoleID
        - name : RoleName
        - description : string
        - permissions : []Permission
        __constructors__
        + {static} NewRole(id, name, description, permissions, now) : (*Role, error)
        + {static} ReconstituteRoleAggregate(id, name, description, permissions) : *Role
        __getters__
        + ID() : RoleID
        + Name() : RoleName
        + Description() : string
        + Permissions() : []Permission
        + PermissionStrings() : []string
        __business methods__
        + AssignPermission(p Permission, now Timepoint)
        + RevokePermission(p Permission, now Timepoint) : error
        + HasPermission(p Permission) : bool
    }

    Role *-- "0..*" Permission : has
    Role o-- EventRecorder : embeds
}

package "RecoveryToken Aggregate" <<Rectangle>> {

    class RecoveryToken <<Aggregate Root>> {
        - id : RecoveryTokenID
        - userID : UserID
        - hashedToken : RecoveryTokenHash
        - expiresAt : Timepoint
        - isUsed : bool
        __constructors__
        + {static} NewRecoveryToken(id, uid, hash, expiresAt, now) : (*RecoveryToken, error)
        + {static} ReconstituteRecoveryToken(id, userID, hashedToken, expiresAt, isUsed) : *RecoveryToken
        __getters__
        + ID() : RecoveryTokenID
        + UserID() : UserID
        + HashedToken() : RecoveryTokenHash
        + ExpiresAt() : Timepoint
        __business methods__
        + IsValid(now Timepoint) : bool
        + IsExpired(now Timepoint) : bool
        + IsUsed() : bool
        + MarkAsUsed(now Timepoint) : error
    }

    RecoveryToken o-- EventRecorder : embeds
    RecoveryToken --> UserID : references
}

package "ActivationToken Aggregate" <<Rectangle>> {

    class ActivationToken <<Aggregate Root>> {
        - id : ActivationTokenID
        - userID : UserID
        - hashedToken : ActivationTokenHash
        - expiresAt : Timepoint
        - isUsed : bool
        __constructors__
        + {static} NewActivationToken(id, uid, hash, expiresAt, now) : (*ActivationToken, error)
        + {static} ReconstituteActivationToken(id, userID, hashedToken, expiresAt, isUsed) : *ActivationToken
        __getters__
        + ID() : ActivationTokenID
        + UserID() : UserID
        + HashedToken() : ActivationTokenHash
        + ExpiresAt() : Timepoint
        __business methods__
        + IsValid(now Timepoint) : bool
        + IsExpired(now Timepoint) : bool
        + IsUsed() : bool
        + MarkAsUsed(now Timepoint) : error
    }

    ActivationToken o-- EventRecorder : embeds
    ActivationToken --> UserID : references
}

@enduml
