@startuml ValueObjects
!theme plain
skinparam classAttributeIconSize 0

title Domain Value Objects

package "Identity" {

    class UserID <<Value Object>> {
        - value : string
        __
        + {static} NewUserID(value string) : (UserID, error)
        + {static} ReconstituteUserID(value string) : UserID
        + String() : string
        + IsEmpty() : bool
        + Equal(other UserID) : bool
    }

    class Email <<Value Object>> {
        - value : string
        __
        + {static} NewEmail(value string) : (Email, error)
        + {static} ReconstituteEmail(email string) : Email
        + String() : string
        + IsEmpty() : bool
        + Equal(other Email) : bool
    }

    class SessionID <<Value Object>> {
        - value : string
        __
        + {static} NewSessionID(value string) : (SessionID, error)
        + {static} ReconstituteSessionID(value string) : SessionID
        + String() : string
        + IsEmpty() : bool
        + Equal(other SessionID) : bool
    }

    class RecoveryTokenID <<Value Object>> {
        - value : string
        __
        + {static} NewRecoveryTokenID(v string) : (RecoveryTokenID, error)
        + {static} ReconstituteRecoveryTokenID(v string) : RecoveryTokenID
        + String() : string
    }

    class ActivationTokenID <<Value Object>> {
        - value : string
        __
        + {static} NewActivationTokenID(v string) : (ActivationTokenID, error)
        + {static} ReconstituteActivationTokenID(v string) : ActivationTokenID
        + String() : string
    }

    class RoleID <<Value Object>> {
        - value : string
        __
        + {static} NewRoleID(value string) : (RoleID, error)
        + {static} ReconstituteRoleID(value string) : RoleID
        + String() : string
        + IsEmpty() : bool
        + Equal(other RoleID) : bool
    }

    class RoleName <<Value Object>> {
        - name : string
        __
        + {static} NewRoleName(name string) : (RoleName, error)
        + {static} ReconstituteRoleName(name string) : RoleName
        + Name() : string
        + Equal(other RoleName) : bool
        + IsEmpty() : bool
    }

    note bottom of RoleName
        Roles are dynamic, defined via
        seed_roles.yml and resolved at
        runtime through IRegistrationRoleProvider.
        No hardcoded constants in domain.
        Validated by regex: ^[a-z][a-z0-9_]{1,49}$
    end note

    class Permission <<Value Object>> {
        - resource : string
        - action : string
        __
        + {static} NewPermission(value string) : (Permission, error)
        + {static} ReconstitutePermission(resource, action string) : Permission
        + Resource() : string
        + Action() : string
        + String() : string
        + IsEmpty() : bool
        + Equal(other Permission) : bool
    }
}

