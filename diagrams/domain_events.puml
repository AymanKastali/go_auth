        + AggregateID() : string
        + RoleName() : string
    }

    class RoleRevokedFromUser <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        - roleName : string
        __
        + {static} NewRoleRevokedFromUser(userID, role, now) : RoleRevokedFromUser
        + EventName() : string
