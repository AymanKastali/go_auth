@startuml AggregateBoundaries
!theme plain
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

title Aggregate Boundaries & Cross-Aggregate References

package "User Aggregate Boundary" #E8F4FD {

    class User <<Aggregate Root>> {
        id : UserID
        email : Email
        passwordHash : HashedPassword
        isActive : bool
        roles : []RoleName
        isDeleted : bool
        registeredAt : Timepoint
    }

    together {
        class UserID <<VO>>
        class Email <<VO>>
        class HashedPassword <<VO>>
        class RoleName <<VO>>
    }

    User *-- UserID
    User *-- Email
    User *-- HashedPassword
    User *-- "0..*" RoleName : has
}

package "Session Aggregate Boundary" #E8FDE8 {

    class Session <<Aggregate Root>> {
        id : SessionID
        userID : UserID
        hashedToken : HashedToken
        identity : DeviceIdentity
        expiresAt : Timepoint
        lastActiveAt : Timepoint
        isRevoked : bool
    }

    together {
        class SessionID <<VO>>
        class HashedToken <<VO>>
        class DeviceIdentity <<VO>>
        class DeviceFingerprint <<VO>>
    }

    Session *-- SessionID
    Session *-- HashedToken
    Session *-- DeviceIdentity
    DeviceIdentity ..> DeviceFingerprint : derives
}

package "Role Aggregate Boundary" #FDE8E8 {

    class Role <<Aggregate Root>> {
        id : RoleID
        name : RoleName
        description : string
        permissions : []Permission
    }

    together {
        class RoleID <<VO>>
        class Permission <<VO>>
    }

    Role *-- RoleID
    Role *-- "0..*" Permission : has
}

package "RecoveryToken Aggregate Boundary" #F3E8FD {

    class RecoveryToken <<Aggregate Root>> {
        id : RecoveryTokenID
        userID : UserID
        hashedToken : RecoveryTokenHash
        expiresAt : Timepoint
        isUsed : bool
    }

    together {
        class RecoveryTokenID <<VO>>
        class RecoveryTokenHash <<VO>>
    }

    RecoveryToken *-- RecoveryTokenID
    RecoveryToken *-- RecoveryTokenHash
}

package "ActivationToken Aggregate Boundary" #FDF3E8 {

    class ActivationToken <<Aggregate Root>> {
        id : ActivationTokenID
        userID : UserID
        hashedToken : ActivationTokenHash
        expiresAt : Timepoint
        isUsed : bool
    }

    together {
        class ActivationTokenID <<VO>>
        class ActivationTokenHash <<VO>>
    }

    ActivationToken *-- ActivationTokenID
    ActivationToken *-- ActivationTokenHash
}

Session -[#red,dashed]-> User : <color:red>cross-aggregate\nreference via UserID</color>
RecoveryToken -[#red,dashed]-> User : <color:red>cross-aggregate\nreference via UserID</color>
ActivationToken -[#red,dashed]-> User : <color:red>cross-aggregate\nreference via UserID</color>

package "Shared Value Objects (not owned by aggregates)" #FFFFF0 {
    class AccessToken <<VO>>
    class AccessIdentity <<VO>>
    class RawToken <<VO>>
    class RawPassword <<VO>>
    class Timepoint <<VO>>
}

package "Domain Services (bridge aggregates)" #F0FFF0 {

    class IRegistrationService <<service>> {
    }
    class IAuthenticationService <<service>> {
    }
    class IAccessManager <<service>> {
    }
    class IUserAccountManager <<service>> {
    }
    class IPasswordManager <<service>> {
    }

    IRegistrationService --> User
    IAuthenticationService --> User
    IAuthenticationService --> Session
    IAccessManager --> User
    IAccessManager --> Session
    IAccessManager --> Role
    IUserAccountManager --> User
    IUserAccountManager --> RecoveryToken
    IUserAccountManager --> ActivationToken
}

package "Repository Ports" #FFF0F0 {

    interface IUserRepository <<port>> {
    }
    interface ISessionRepository <<port>> {
    }
    interface IRoleRepository <<port>> {
    }
    interface IRecoveryTokenRepository <<port>> {
    }
    interface IActivationTokenRepository <<port>> {
    }

    IUserRepository --> User : persists
    ISessionRepository --> Session : persists
    IRoleRepository --> Role : persists
    IRecoveryTokenRepository --> RecoveryToken : persists
    IActivationTokenRepository --> ActivationToken : persists
}

@enduml
