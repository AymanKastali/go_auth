@startuml DomainEvents
!include _style.puml

title Domain Events

package "Event Infrastructure" {

    interface DomainEvent {
        + EventName() : string
        + OccurredAt() : time.Time
        + AggregateID() : string
    }

    class EventRecorder <<Mixin>> {
        - events : []DomainEvent
        + RecordEvent(event DomainEvent)
        + CollectEvents() : []DomainEvent
    }

    EventRecorder o-- "0..*" DomainEvent : collects
}

package "User Events" {

    class UserRegistered <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        - email : string
        __
        + {static} NewUserRegistered(userID, email, now) : UserRegistered
        + EventName() : string
        + OccurredAt() : time.Time
        + AggregateID() : string
        + Email() : string
    }

    class UserActivated <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        __
        + {static} NewUserActivated(userID, now) : UserActivated
