        + AggregateID() : string
        + RoleName() : string
    }

    class EmailUpdated <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        - oldEmail : string
        - newEmail : string
        __
        + {static} NewEmailUpdated(userID, oldEmail, newEmail, now) : EmailUpdated
        + EventName() : string
        + OccurredAt() : time.Time
        + AggregateID() : string
        + OldEmail() : string
        + NewEmail() : string
    }

    class PasswordChanged <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        __
        + {static} NewPasswordChanged(userID, now) : PasswordChanged
        + EventName() : string
        + OccurredAt() : time.Time
        + AggregateID() : string
    }

    class UserLoginFailed <<Domain Event>> {
        - occurredAt : time.Time
        - aggregateID : string
        - email : string
