# --- App Configuration ---
GA_APP_NAME=GoAuth
GA_APP_ENV=development
GA_DEBUG=true
GA_LOG_LEVEL=debug

# --- HTTP Server ---
GA_HTTP_PORT=8080

# --- Database ---
GA_DATABASE_URL=postgres://postgres:postgres@postgres:5432/auth_db?sslmode=disable

# --- JWT (Security Boundary) ---
GA_JWT_SECRET=eydZZFZYPXYWrslGB7mcr56H/Ijqr9Ot06G+aYzX5wTSC7r0tEMbycPUKm9HzPXY79uGaAZNICh6AA/izQWSFQ==
GA_JWT_ISSUER=go-auth-service
GA_JWT_AUDIENCE=go-web-client
GA_JWT_ACCESS_TTL=15m

# --- Infrastructure Hashing (Bcrypt) ---
GA_PASSWORD_BCRYPT_COST=12

# --- Domain Password Policy ---
GA_PASS_MIN_LEN=12
GA_PASS_MAX_LEN=128
GA_PASS_REQ_UPPER=true
GA_PASS_REQ_NUM=true
GA_PASS_REQ_SPECIAL=true

# --- Domain Session Policy ---
GA_SESSION_LIFETIME=24h
GA_SESSION_MAX_ACTIVE=5

# --- System Seeding (Initial Super Admin) ---
GA_ADMIN_EMAIL=admin@go-auth.com
GA_ADMIN_PASSWORD=SuperAdminPass1!

# --- Domain Recovery Policy ---
GA_RECOVERY_TOKEN_LIFETIME=15m

# --- Domain Registration Policy ---
GA_REGISTER_ALLOW_PUBLIC=true
GA_REGISTER_BLOCKED_DOMAINS=gmail.com,yahoo.com

# --- Email / SMTP ---
GA_EMAIL_HOST=localhost
GA_EMAIL_PORT=587
GA_EMAIL_USERNAME=
GA_EMAIL_PASSWORD=
GA_EMAIL_FROM=ayman-kastali@no-reply.com
GA_EMAIL_RESET_BASE_URL=http://localhost:3000/reset-password