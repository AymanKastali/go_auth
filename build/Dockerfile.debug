FROM golang:1.25 AS dev

# 1. Install Delve and Swag
RUN go install github.com/go-delve/delve/cmd/dlv@latest \
    && go install github.com/swaggo/swag/cmd/swag@latest

WORKDIR /workspace

# 2. Download dependencies
COPY go.mod go.sum ./
RUN go mod download

# 3. Copy all source code (needed for debugging)
COPY ./build ./build
COPY ./config ./config
COPY ./cmd ./cmd
COPY ./internal ./internal

# 4. Generate Swagger docs
RUN swag init -g cmd/server/main.go --parseDependency --parseInternal -o ./docs

# 5. Expose ports
EXPOSE 8080 2345

# 6. Run Delve (exact same command you had)
ENTRYPOINT ["dlv", "debug", "./cmd/server/main.go", "--headless", "--listen=:2345", "--api-version=2", "--accept-multiclient", "--continue", "--", "--port=8080"]
