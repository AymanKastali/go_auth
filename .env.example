# ============================================================
# GoAuth — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# Variables marked [REQUIRED] have no default and must be set.
# Variables with (default: …) will use that value if unset.
# ============================================================

# --- App Configuration ---
GA_APP_NAME=GoAuthService              # (default: GoAuthService)
GA_APP_ENV=development                 # (default: development)
GA_DEBUG=false                         # (default: false)
GA_LOG_LEVEL=info                      # (default: info) — debug | info | warn | error

# --- HTTP Server ---
GA_HTTP_PORT=8080                      # (default: 8080)

# --- Database ---
GA_DATABASE_URL=postgres://user:password@localhost:5432/auth_db?sslmode=disable  # [REQUIRED]

# --- JWT (Security Boundary) ---
GA_JWT_SECRET=change-me-to-a-base64-secret   # [REQUIRED] — base64-encoded HMAC key
GA_JWT_ISSUER=go-auth-service                # (default: go-auth-service)
GA_JWT_AUDIENCE=go-auth-client               # (default: go-auth-client)
GA_JWT_ACCESS_TTL=15m                        # (default: 15m)

# --- Infrastructure Hashing (Bcrypt) ---
GA_PASSWORD_BCRYPT_COST=12             # (default: 12)

# --- Domain Password Policy ---
GA_PASS_MIN_LEN=8                      # (default: 8)
GA_PASS_MAX_LEN=64                     # (default: 64)
GA_PASS_REQ_UPPER=true                 # (default: true)
GA_PASS_REQ_NUM=true                   # (default: true)
GA_PASS_REQ_SPECIAL=true               # (default: true)

# --- Domain Session Policy ---
GA_SESSION_LIFETIME=24h                # (default: 24h)
GA_SESSION_MAX_ACTIVE=5                # (default: 5)

# --- Domain Recovery Policy ---
GA_RECOVERY_TOKEN_LIFETIME=15m         # (default: 15m)

# --- Domain Registration Policy ---
GA_REGISTER_ALLOW_PUBLIC=true          # (default: true)
GA_REGISTER_BLOCKED_DOMAINS=           # (default: "") — comma-separated list, e.g. tempmail.com,throwaway.io

# --- System Seeding ---
GA_ADMIN_EMAIL=admin@example.com       # [REQUIRED]
GA_ADMIN_PASSWORD=ChangeMe1!           # [REQUIRED]
GA_SEED_ROLES_PATH=/config/seed_roles.yml  # (default: /config/seed_roles.yml) — path to roles & permissions YAML

# --- Email / SMTP ---
GA_EMAIL_HOST=localhost                # (default: localhost)
GA_EMAIL_PORT=587                      # (default: 587)
GA_EMAIL_USERNAME=                     # (default: "")
GA_EMAIL_PASSWORD=                     # (default: "")
GA_EMAIL_FROM=noreply@example.com      # [REQUIRED]
GA_EMAIL_RESET_BASE_URL=http://localhost:3000/reset-password  # [REQUIRED]
