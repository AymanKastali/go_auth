@startuml DomainServices
!include _style.puml

title Domain Services — Interfaces, Implementations & Dependency Wiring

package "Registration Services" {

    interface IRegisterMember {
        + Register(id, email, pwd, defaultRole, now) : (*User, error)
    }

    class registerMember <<Domain Service>> {
        - registerPolicy : IRegisterPolicy
        - activationPolicy : IActivationPolicy
        __
        + {static} NewRegisterMember(registerPolicy, activationPolicy) : IRegisterMember
        + Register(id, email, pwd, defaultRole, now) : (*User, error)
    }

    interface IRegisterAdmin {
        + Register(id, email, pwd, defaultRole, now) : (*User, error)
    }

    class registerAdmin <<Domain Service>> {
        - registerPolicy : IRegisterPolicy
        __
        + {static} NewRegisterAdmin(registerPolicy) : IRegisterAdmin
        + Register(id, email, pwd, defaultRole, now) : (*User, error)
    }

    IRegisterMember <|.. registerMember
    IRegisterAdmin <|.. registerAdmin
}

package "Credential Services" {

    interface IVerifyCredentials {
        + Verify(user *User, rawPassword string) : error
    }

    class verifyCredentials <<Domain Service>> {
        - passwordSvc : IPasswordService
        __
        + {static} NewVerifyCredentials(passwordSvc) : IVerifyCredentials
        + Verify(user *User, rawPassword string) : error
    }

    interface IChangePassword {
        + Change(user, oldPass, newPass ValidatedPassword, now) : error
    }

    class changePassword <<Domain Service>> {
        - passwordSvc : IPasswordService
        __
        + {static} NewChangePassword(passwordSvc) : IChangePassword
        + Change(user, oldPass, newPass ValidatedPassword, now) : error
    }

    interface IResetPassword {
        + Reset(user, recovery, newPassword ValidatedPassword, now) : error
    }

    class resetPassword <<Domain Service>> {
        - passwordSvc : IPasswordService
        __
        + {static} NewResetPassword(passwordSvc) : IResetPassword
        + Reset(user, recovery, newPassword ValidatedPassword, now) : error
    }

    IVerifyCredentials <|.. verifyCredentials
    IChangePassword <|.. changePassword
    IResetPassword <|.. resetPassword
}

package "Session Services" {

    interface IOpenSession {
        + Open(existingSession, activeSessions, userID, identity, now) : (string, *Session, *Session, error)
    }

    class openSession <<Domain Service>> {
        - tokenSvc : ITokenService
        - idGen : IIDGenerator
        - sessionPolicy : ISessionPolicy
        __
        + {static} NewOpenSession(tokenSvc, idGen, sessionPolicy) : IOpenSession
        + Open(existingSession, activeSessions, userID, identity, now) : (string, *Session, *Session, error)
    }

    interface IRefreshSession {
        + Refresh(session, foundByPreviousToken, fp, now) : (string, error)
    }

    class refreshSession <<Domain Service>> {
        - tokenSvc : ITokenService
        - sessionPolicy : ISessionPolicy
        __
        + {static} NewRefreshSession(tokenSvc, sessionPolicy) : IRefreshSession
        + Refresh(session, foundByPreviousToken, fp, now) : (string, error)
    }

    IOpenSession <|.. openSession
    IRefreshSession <|.. refreshSession
}

package "Access Services" {

    interface IResolvePermissions {
        + Resolve(roles []*Role) : []Permission
    }

    class resolvePermissions <<Domain Service>> {
        __
        + {static} NewResolvePermissions() : IResolvePermissions
        + Resolve(roles []*Role) : []Permission
    }

    interface IGrantAccess {
        + Grant(user, sid, roles []*Role, now) : (AccessToken, time.Time, error)
    }

    class grantAccess <<Domain Service>> {
        - permResolver : IResolvePermissions
        - accessSvc : IAccessService
        - accessPolicy : IAccessPolicy
        __
        + {static} NewGrantAccess(permResolver, accessSvc, accessPolicy) : IGrantAccess
        + Grant(user, sid, roles []*Role, now) : (AccessToken, time.Time, error)
    }

    IResolvePermissions <|.. resolvePermissions
    IGrantAccess <|.. grantAccess
}

package "Recovery & Activation Services" {

    interface IInitiateRecovery {
        + Initiate(user, now) : (string, *RecoveryToken, error)
    }

    class initiateRecovery <<Domain Service>> {
        - tokenSvc : ITokenService
        - idGen : IIDGenerator
        - recoveryPolicy : IRecoveryPolicy
        __
        + {static} NewInitiateRecovery(tokenSvc, idGen, recoveryPolicy) : IInitiateRecovery
        + Initiate(user, now) : (string, *RecoveryToken, error)
    }

    interface IInitiateActivation {
        + Initiate(user, now) : (string, *ActivationToken, error)
    }

    class initiateActivation <<Domain Service>> {
        - tokenSvc : ITokenService
        - idGen : IIDGenerator
        - activationPolicy : IActivationPolicy
        __
        + {static} NewInitiateActivation(tokenSvc, idGen, activationPolicy) : IInitiateActivation
        + Initiate(user, now) : (string, *ActivationToken, error)
    }

    interface IConfirmActivation {
        + Confirm(user, activation, now) : error
    }

    class confirmActivation <<Domain Service>> {
        __
        + {static} NewConfirmActivation() : IConfirmActivation
        + Confirm(user, activation, now) : error
    }

    IInitiateRecovery <|.. initiateRecovery
    IInitiateActivation <|.. initiateActivation
    IConfirmActivation <|.. confirmActivation
}

package "Ports" <<Cloud>> {
    interface IPasswordService <<port>>
    interface ITokenService <<port>>
    interface IIDGenerator <<port>>
    interface IAccessService <<port>>
}

package "Policies" <<Cloud>> {
    interface IRegisterPolicy <<policy>>
    interface IActivationPolicy <<policy>>
    interface ISessionPolicy <<policy>>
    interface IAccessPolicy <<policy>>
    interface IRecoveryPolicy <<policy>>
}

' --- Registration wiring ---
registerMember --> IRegisterPolicy
registerMember --> IActivationPolicy
registerAdmin --> IRegisterPolicy

' --- Credential wiring ---
verifyCredentials --> IPasswordService
changePassword --> IPasswordService
resetPassword --> IPasswordService

' --- Session wiring ---
openSession --> ITokenService
openSession --> IIDGenerator
openSession --> ISessionPolicy
refreshSession --> ITokenService
refreshSession --> ISessionPolicy

' --- Access wiring ---
grantAccess --> IResolvePermissions
grantAccess --> IAccessService
grantAccess --> IAccessPolicy

' --- Recovery & Activation wiring ---
initiateRecovery --> ITokenService
initiateRecovery --> IIDGenerator
initiateRecovery --> IRecoveryPolicy
initiateActivation --> ITokenService
initiateActivation --> IIDGenerator
initiateActivation --> IActivationPolicy

@enduml
