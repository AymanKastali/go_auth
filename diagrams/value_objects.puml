package "Device" {

    class DeviceIdentity <<Value Object>> {
        - ipAddress : string
        - os : string
        - browser : string
        - model : string
        - language : string
        - userAgent : string
        - isMobile : bool
        __
        + {static} NewDeviceIdentity(ip, os, browser, model, lang, ua, isMobile) : (DeviceIdentity, error)
        + {static} ReconstituteDeviceIdentity(ip, os, browser, model, lang, ua, isMobile) : DeviceIdentity
        + Fingerprint() : DeviceFingerprint
        + DisplayName() : string
        + IPAddress() : string
        + OS() : string
        + Browser() : string
        + Model() : string
        + Language() : string
        + UserAgent() : string
        + IsMobile() : bool
    }

    class DeviceFingerprint <<Value Object>> {
        - value : string
        __
        + {static} NewDeviceFingerprintFromIdentity(ua, ip, lang) : DeviceFingerprint
        + {static} NewDeviceFingerprint(value string) : (DeviceFingerprint, error)
        + String() : string
        + Equal(other DeviceFingerprint) : bool
    }

    DeviceIdentity ..> DeviceFingerprint : derives via Fingerprint()
}

package "Time & Access" {

    class Timepoint <<Value Object>> {
        - time : time.Time
        __
        + {static} NewTimepoint(t time.Time) : Timepoint
        + {static} ReconstituteTimepoint(t time.Time) : Timepoint
        + Time() : time.Time
        + IsBefore(other Timepoint) : bool
        + IsAfter(other Timepoint) : bool
        + Add(d time.Duration) : Timepoint
        + Equal(other Timepoint) : bool
        + String() : string
        + IsZero() : bool
    }

    class AccessIdentity <<Value Object>> {
        - userID : UserID
        - sessionID : SessionID
        - email : Email
        - roles : []Role
        __
        + {static} NewAccessIdentity(userID, sessionID, email, roles) : (AccessIdentity, error)
        + UserID() : UserID
        + SessionID() : SessionID
        + Email() : Email
        + Roles() : []Role
    }

    AccessIdentity --> UserID
    AccessIdentity --> SessionID
    AccessIdentity --> Email
    AccessIdentity --> Role
}

@enduml
