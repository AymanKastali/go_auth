@startuml Aggregates
!include _style.puml

title Domain Aggregates

package "User Aggregate" <<Rectangle>> {

    class User <<Aggregate Root>> {
        - id : UserID
        - email : Email
        - passwordHash : HashedPassword
        - isActive : bool
        - roles : []RoleName
        - isDeleted : bool
        - registeredAt : time.Time
        - failedLoginAttempts : int
        - lockedUntil : *time.Time
        __constructors__
        + {static} NewUser(userID, email, passwordHash, registeredAt) : (*User, error)
        + {static} ReconstituteUser(id, email, passwordHash, isActive, roles, isDeleted, registeredAt, failedLoginAttempts, lockedUntil) : *User
        __getters__
        + ID() : UserID
        + Email() : Email
        + HashedPassword() : HashedPassword
        + Roles() : []RoleName
        + IsDeleted() : bool
        + IsActive() : bool
        + RegisteredAt() : time.Time
        + FailedLoginAttempts() : int
        + LockedUntil() : *time.Time
        + RoleNames() : []string
        __business methods__
        + Activate(now time.Time) : error
        + Deactivate(now time.Time) : error
        + AssignRole(role RoleName, now time.Time) : error
        + RemoveRole(role RoleName, now time.Time) : error
        + MarkDeleted(now time.Time) : error
        + UpdateEmail(newEmail Email, now time.Time) : error
        + UpdatePassword(newHash HashedPassword, now time.Time) : error
        __lockout behavior__
        + IsLocked(now time.Time) : bool
        + RecordFailedLogin(maxAttempts int, lockoutDuration time.Duration, now time.Time)
        + ResetLoginAttempts()
    }

    class EventRecorder <<Mixin>> {
        - events : []DomainEvent
        + RecordEvent(event DomainEvent)
        + CollectEvents() : []DomainEvent
    }

    User *-- "0..*" RoleName : has
    User o-- EventRecorder : embeds
}

package "Session Aggregate" <<Rectangle>> {

    class Session <<Aggregate Root>> {
        - id : SessionID
        - userID : UserID
        - hashedToken : HashedToken
        - previousHashedToken : HashedToken
        - identity : DeviceIdentity
        - expiry : SessionExpiry
        - lastActiveAt : time.Time
        - isRevoked : bool
        __constructors__
        + {static} NewSession(id, userID, hashedToken, identity, expiry, now) : (*Session, error)
        + {static} ReconstituteSession(id, userID, hashedToken, previousHashedToken, identity, expiresAt, lastActiveAt, isRevoked) : *Session
        __getters__
        + ID() : SessionID
        + UserID() : UserID
        + HashedToken() : HashedToken
        + PreviousHashedToken() : HashedToken
        + Expiry() : SessionExpiry
        + LastActiveAt() : time.Time
        + IsRevoked() : bool
        + Identity() : DeviceIdentity
        + DisplayName() : string
        __business methods__
        + IsValid(now time.Time) : bool
        + ValidateFingerprint(fp DeviceFingerprint) : bool
        + UpdateLogin(newToken HashedToken, newExpiry SessionExpiry, now time.Time)
        + Revoke(now time.Time) : error
        + Refresh(newHashedToken HashedToken, currentFP DeviceFingerprint, newExpiry SessionExpiry, now time.Time) : error
        + RevokeForTokenReuse(now time.Time) : error
        + UpdateActivity(now time.Time)
    }

    Session o-- EventRecorder : embeds
    Session --> UserID : references
}

package "Role Aggregate" <<Rectangle>> {

    class Role <<Aggregate Root>> {
        - id : RoleID
        - name : RoleName
        - description : string
        - permissions : []Permission
        __constructors__
        + {static} NewRole(id, name, description, permissions, now) : (*Role, error)
        + {static} ReconstituteRole(id, name, description, permissions) : *Role
        __getters__
        + ID() : RoleID
        + Name() : RoleName
        + Description() : string
        + Permissions() : []Permission
        + PermissionStrings() : []string
        __business methods__
        + AssignPermission(p Permission, now time.Time)
        + RevokePermission(p Permission, now time.Time) : error
        + HasPermission(p Permission) : bool
    }

    Role *-- "0..*" Permission : has
    Role o-- EventRecorder : embeds
}

package "RecoveryToken Aggregate" <<Rectangle>> {

    class RecoveryToken <<Aggregate Root>> {
        - id : RecoveryTokenID
        - userID : UserID
        - hashedToken : RecoveryTokenHash
        - expiresAt : time.Time
        - isUsed : bool
        __constructors__
        + {static} NewRecoveryToken(id, uid, hash, expiresAt, now) : (*RecoveryToken, error)
        + {static} ReconstituteRecoveryToken(id, userID, hashedToken, expiresAt, isUsed) : *RecoveryToken
        __getters__
        + ID() : RecoveryTokenID
        + UserID() : UserID
        + HashedToken() : RecoveryTokenHash
        + ExpiresAt() : time.Time
        __business methods__
        + IsValid(now time.Time) : bool
        + IsExpired(now time.Time) : bool
        + IsUsed() : bool
        + MarkAsUsed(now time.Time) : error
    }

    RecoveryToken o-- EventRecorder : embeds
    RecoveryToken --> UserID : references
}

package "ActivationToken Aggregate" <<Rectangle>> {

    class ActivationToken <<Aggregate Root>> {
        - id : ActivationTokenID
        - userID : UserID
        - hashedToken : ActivationTokenHash
        - expiresAt : time.Time
        - isUsed : bool
        __constructors__
        + {static} NewActivationToken(id, uid, hash, expiresAt, now) : (*ActivationToken, error)
        + {static} ReconstituteActivationToken(id, userID, hashedToken, expiresAt, isUsed) : *ActivationToken
        __getters__
        + ID() : ActivationTokenID
        + UserID() : UserID
        + HashedToken() : ActivationTokenHash
        + ExpiresAt() : time.Time
        __business methods__
        + IsValid(now time.Time) : bool
        + IsExpired(now time.Time) : bool
        + IsUsed() : bool
        + MarkAsUsed(now time.Time) : error
    }

    ActivationToken o-- EventRecorder : embeds
    ActivationToken --> UserID : references
}

@enduml
