@startuml AggregateBoundaries
!include _style.puml
skinparam packageStyle rectangle

title Aggregate Boundaries & Cross-Aggregate References

package "User Aggregate Boundary" {

    class User <<Aggregate Root>> {
        id : UserID
        email : Email
        passwordHash : HashedPassword
        isActive : bool
        roles : []RoleName
        isDeleted : bool
        registeredAt : time.Time
        failedLoginAttempts : int
        lockedUntil : *time.Time
    }

    together {
        class UserID <<Value Object>>
        class Email <<Value Object>>
        class HashedPassword <<Value Object>>
        class RoleName <<Value Object>>
    }

    User *-- UserID
    User *-- Email
    User *-- HashedPassword
    User *-- "0..*" RoleName : has
}

package "Session Aggregate Boundary" {

    class Session <<Aggregate Root>> {
        id : SessionID
        userID : UserID
        hashedToken : HashedToken
        previousHashedToken : HashedToken
        identity : DeviceIdentity
        expiry : SessionExpiry
        lastActiveAt : time.Time
        isRevoked : bool
    }

    together {
        class SessionID <<Value Object>>
        class HashedToken <<Value Object>>
        class SessionExpiry <<Value Object>>
        class DeviceIdentity <<Value Object>>
        class DeviceFingerprint <<Value Object>>
    }

    Session *-- SessionID
    Session *-- HashedToken
    Session *-- SessionExpiry
    Session *-- DeviceIdentity
    DeviceIdentity ..> DeviceFingerprint : derives
}

package "Role Aggregate Boundary" {

    class Role <<Aggregate Root>> {
        id : RoleID
        name : RoleName
        description : string
        permissions : []Permission
    }

    together {
        class RoleID <<Value Object>>
        class Permission <<Value Object>>
    }

    Role *-- RoleID
    Role *-- "0..*" Permission : has
}

package "RecoveryToken Aggregate Boundary" {

    class RecoveryToken <<Aggregate Root>> {
        id : RecoveryTokenID
        userID : UserID
        hashedToken : RecoveryTokenHash
        expiresAt : time.Time
        isUsed : bool
    }

    together {
        class RecoveryTokenID <<Value Object>>
        class RecoveryTokenHash <<Value Object>>
    }

    RecoveryToken *-- RecoveryTokenID
    RecoveryToken *-- RecoveryTokenHash
}

package "ActivationToken Aggregate Boundary" {

    class ActivationToken <<Aggregate Root>> {
        id : ActivationTokenID
        userID : UserID
        hashedToken : ActivationTokenHash
        expiresAt : time.Time
        isUsed : bool
    }

    together {
        class ActivationTokenID <<Value Object>>
        class ActivationTokenHash <<Value Object>>
    }

    ActivationToken *-- ActivationTokenID
    ActivationToken *-- ActivationTokenHash
}

Session -[#F38BA8,dashed]-> User : <color:#F38BA8>cross-aggregate\nreference via UserID</color>
RecoveryToken -[#F38BA8,dashed]-> User : <color:#F38BA8>cross-aggregate\nreference via UserID</color>
ActivationToken -[#F38BA8,dashed]-> User : <color:#F38BA8>cross-aggregate\nreference via UserID</color>

package "Shared Value Objects (not owned by aggregates)" {
    class AccessToken <<Value Object>>
    class AccessIdentity <<Value Object>>
    class ValidatedPassword <<Value Object>>
}

package "Domain Services (bridge aggregates)" {

    class IRegisterMember <<service>>
    class IRegisterAdmin <<service>>
    class IVerifyCredentials <<service>>
    class IChangePassword <<service>>
    class IResetPassword <<service>>
    class IOpenSession <<service>>
    class IRefreshSession <<service>>
    class IGrantAccess <<service>>
    class IResolvePermissions <<service>>
    class IInitiateRecovery <<service>>
    class IInitiateActivation <<service>>
    class IConfirmActivation <<service>>

    IRegisterMember --> User
    IRegisterAdmin --> User
    IVerifyCredentials --> User
    IChangePassword --> User
    IResetPassword --> User
    IResetPassword --> RecoveryToken
    IOpenSession --> Session
    IRefreshSession --> Session
    IGrantAccess --> User
    IGrantAccess --> Role
    IResolvePermissions --> Role
    IInitiateRecovery --> User
    IInitiateRecovery --> RecoveryToken
    IInitiateActivation --> User
    IInitiateActivation --> ActivationToken
    IConfirmActivation --> User
    IConfirmActivation --> ActivationToken
}

package "Repository Ports" {

    interface IUserRepository <<port>>
    interface ISessionRepository <<port>>
    interface IRoleRepository <<port>>
    interface IRecoveryTokenRepository <<port>>
    interface IActivationTokenRepository <<port>>

    IUserRepository --> User : persists
    ISessionRepository --> Session : persists
    IRoleRepository --> Role : persists
    IRecoveryTokenRepository --> RecoveryToken : persists
    IActivationTokenRepository --> ActivationToken : persists
}

@enduml
